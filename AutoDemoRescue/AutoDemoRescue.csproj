  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Salaros.ConfigParser" Version="0.3.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunOnStartup\RunOnStartup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.ini">
